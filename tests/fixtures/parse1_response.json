[[{"bbox": {"xmin": 0.11735163398692809, "ymin": 0.041397979797979816, "xmax": 0.4908444444444445, "ymax": 0.07682424242424242}, "text": "Enterprise Support Policy", "type": "Section-header"}, {"bbox": {"xmin": 0.11735163398692809, "ymin": 0.08587474747474748, "xmax": 0.5079437908496732, "ymax": 0.10914747474747473}, "text": "This document is restricted to support leads.", "type": "Text"}, {"bbox": {"xmin": 0.11735163398692809, "ymin": 0.12427474747474748, "xmax": 0.25279999999999997, "ymax": 0.14845252525252525}, "text": "Escalation", "type": "Section-header"}, {"bbox": {"xmin": 0.11735163398692809, "ymin": 0.14948686868686867, "xmax": 0.8313503267973855, "ymax": 0.18995555555555554}, "text": "Enterprise incidents with customer impact should be escalated to the support lead within 30 minutes.", "type": "Text"}, {"bbox": {"xmin": 0.11735163398692809, "ymin": 0.20004040404040407, "xmax": 0.8786091503267974, "ymax": 0.240379797979798}, "text": "If a customer has more than three open priority cases or an unresolved case older than 14 days, the account should be marked as elevated risk for the weekly support review.", "type": "Text"}, {"bbox": {"xmin": 0.11735163398692809, "ymin": 0.25757575757575757, "xmax": 0.3369503267973856, "ymax": 0.2869252525252525}, "text": "Response Targets", "type": "Section-header"}, {"bbox": {"xmin": 0.11735163398692809, "ymin": 0.28989898989898993, "xmax": 0.6459503267973857, "ymax": 0.308129292929293}, "text": "Priority 1 cases require an initial response within 15 minutes.", "type": "Text"}, {"bbox": {"xmin": 0.11735163398692809, "ymin": 0.30903434343434344, "xmax": 0.6183490196078432, "ymax": 0.3272646464646465}, "text": "Priority 2 cases require an initial response within 2 hours.", "type": "Text"}, {"bbox": {"xmin": 0.11735163398692809, "ymin": 0.3282989898989899, "xmax": 0.6827071895424838, "ymax": 0.3464}, "text": "Priority 3 cases require an initial response within 1 business day.", "type": "Text"}]]